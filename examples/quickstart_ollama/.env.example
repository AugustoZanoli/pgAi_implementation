# Credenciais do Postgres (imagem timescale/timescaledb-ha, com pgai)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Porta publicada no host (o Postgres escuta em 5432 dentro do container)
POSTGRES_HOST_PORT=

# Endereco do Ollama acessivel a partir do vectorizer-worker
OLLAMA_HOST=

# Intervalo de polling do vectorizer-worker
POLL_INTERVAL=

# Tag da imagem do vectorizer-worker (use latest ou versao recente que inclua o comando 'install')
VECTORIZER_WORKER_TAG=latest
